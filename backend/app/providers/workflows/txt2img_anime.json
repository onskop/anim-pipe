{
  "_animpipe": {
    "note": "Standard SD txt2img. Wire 'checkpoint' to an anime model (e.g. an Illustrious/Pony/AnimagineXL checkpoint). To add character LoRA + IP-Adapter for consistency, insert LoraLoader / IPAdapter nodes in the ComfyUI editor, re-export API JSON, and extend the patch map below.",
    "patch": {
      "checkpoint": ["4", "ckpt_name"],
      "positive": ["6", "text"],
      "negative": ["7", "text"],
      "seed": ["3", "seed"],
      "steps": ["3", "steps"],
      "cfg": ["3", "cfg"],
      "width": ["5", "width"],
      "height": ["5", "height"]
    }
  },
  "4": {
    "class_type": "CheckpointLoaderSimple",
    "inputs": { "ckpt_name": "DreamShaper_8_pruned.safetensors" }
  },
  "5": {
    "class_type": "EmptyLatentImage",
    "inputs": { "width": 768, "height": 768, "batch_size": 1 }
  },
  "6": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "placeholder positive", "clip": ["4", 1] }
  },
  "7": {
    "class_type": "CLIPTextEncode",
    "inputs": { "text": "placeholder negative", "clip": ["4", 1] }
  },
  "3": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 0, "steps": 28, "cfg": 6.5, "sampler_name": "euler",
      "scheduler": "normal", "denoise": 1.0,
      "model": ["4", 0], "positive": ["6", 0], "negative": ["7", 0], "latent_image": ["5", 0]
    }
  },
  "8": {
    "class_type": "VAEDecode",
    "inputs": { "samples": ["3", 0], "vae": ["4", 2] }
  },
  "9": {
    "class_type": "SaveImage",
    "inputs": { "filename_prefix": "animpipe", "images": ["8", 0] }
  }
}
