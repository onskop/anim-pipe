# Copy to .env and edit. All settings are optional — defaults run on the Mock
# provider with no GPU and no keys.

# --- Provider selection: "mock" (default) | "comfyui" / "openrouter" ---
# ANIMPIPE_IMAGE_PROVIDER=comfyui
# ANIMPIPE_VIDEO_PROVIDER=comfyui
# ANIMPIPE_UPSCALE_PROVIDER=comfyui
# ANIMPIPE_LLM_PROVIDER=openrouter

# --- Local ComfyUI (GPU box) ---
# ANIMPIPE_COMFYUI_URL=http://127.0.0.1:8188

# --- OpenRouter (swappable intelligence line) ---
# ANIMPIPE_OPENROUTER_API_KEY=sk-or-...
# ANIMPIPE_LLM_TEXT_MODEL=anthropic/claude-3.5-sonnet
# ANIMPIPE_LLM_VISION_MODEL=anthropic/claude-3.5-sonnet

# --- Generation defaults ---
# ANIMPIPE_DEFAULT_CANDIDATES=4
# ANIMPIPE_MAX_CONCURRENT_JOBS=2
# ANIMPIPE_DATA_DIR=data
